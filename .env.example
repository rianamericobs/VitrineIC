NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./var/vitrineic.sqlite
# Nunca habilite contas de exemplo em produção. Execute pnpm db:seed explicitamente.
DEMO_MODE=false
# Desenvolvimento: e-mails são gravados em var/mail/*.eml, sem envio externo.
MAIL_MODE=file
MAIL_DIRECTORY=./var/mail
REQUIRE_VERIFIED_EMAIL=false
# Produção: MAIL_MODE=smtp ou resend e REQUIRE_VERIFIED_EMAIL=true.
# Render Free bloqueia SMTP nas portas 25, 465 e 587; use HTTPS (resend).
# MAIL_MODE=resend
# RESEND_API_KEY=seu-segredo
# MAIL_FROM=seu-remetente@seu-dominio
# SMTP_HOST=smtp.seu-provedor
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu-usuario
# SMTP_PASSWORD=seu-segredo
# Produção: NODE_ENV=production, HOST=0.0.0.0, APP_ORIGIN=https://seu-dominio
# O banco precisa de volume persistente; use /data/vitrineic.sqlite no Railway/Docker.
# Render: veja docs/render.md. O render.yaml gratuito usa SQLite DESCARTÁVEL.
# APP_ORIGIN é opcional no Render: usa RENDER_EXTERNAL_URL; defina para domínio próprio.
# Bootstrap opcional no início do processo (sem rota HTTP de administração):
# BOOTSTRAP_CURATOR=true
# CURATOR_EMAIL=curador@seu-dominio
# CURATOR_NAME=Curadoria
# CURATOR_PASSWORD=senha-forte-exclusiva
