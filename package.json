{
  "name": "vitrineic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "pnpm typecheck && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env build/server.mjs",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "tsx --test server/tests/*.test.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/seed.ts",
    "curator:create": "tsx --env-file-if-exists=.env server/create-curator.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "fastify": "^5.6.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/multipart": "^9.2.1",
    "zod": "^3.25.76",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "tsx": "^4.20.6",
    "esbuild": "^0.28.0",
    "concurrently": "^9.2.1",
    "@types/nodemailer": "^8.0.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.34.3"
}
